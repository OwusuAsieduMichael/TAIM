# --- Express + Prisma (default) ---
# VITE_API_BACKEND=express
# Optional. Omit in local dev so requests use /api (Vite proxy → API on port 4000).
# VITE_API_URL=http://localhost:4000

# Production (Vercel + Render): set this to your Render API origin (no trailing slash).
# VITE_API_URL=https://taim-api.onrender.com

# --- Google Apps Script + Sheets (free backend) ---
# VITE_API_BACKEND=gas
# Deploy apps/gas as a Web App, then paste the /exec URL here:
# VITE_GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
#
# Demo one-tap login with credentials shown (default on). Set false for production-only auth:
# VITE_DEMO_LOGIN=true
#
# Local dev: leave VITE_API_URL empty; Vite proxies /api/gas → VITE_GAS_URL.
# Production (Vercel): set VITE_API_BACKEND=gas and VITE_GAS_URL (or VITE_API_URL) to the /exec URL.
